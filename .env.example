# Copy to .env (never commit .env). All three providers are free; no card needed.

# Google AI Studio -> Get API key  (https://aistudio.google.com)
GEMINI_API_KEY=

# Cloudflare dashboard -> Account ID (right sidebar) and
# My Profile -> API Tokens -> Create Token -> template "Workers AI"
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Kaggle -> Settings -> API -> Create New Token (downloads kaggle.json with both values)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional
GEMINI_TEXT_MODEL=gemini-3.8-flash
# KAGGLE_ACCELERATOR=NvidiaTeslaT4
